---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Frame from '../ui/Frame.astro';
import { UI, type Lang } from '../../i18n/ui';
import { getCareers, getJobs, getSite, hasImage } from '../../lib/content';
import { withBase } from '../../lib/paths';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang].jobs;
const [page, site, jobEntries] = await Promise.all([getCareers(lang), getSite(lang), getJobs(lang)]);
const jobs = await Promise.all(jobEntries.map(async (j) => ({ ...j.data, id: j.id, Content: (await render(j)).Content })));
const pad = (n: number) => String(n).padStart(2, '0');
const date = (d: Date) => d.toLocaleDateString(lang === 'de' ? 'de-DE' : 'en-GB', { dateStyle: 'long' });
const mail = (email: string, subject: string) => `mailto:${email}?subject=${encodeURIComponent(subject)}`;
---

<Base lang={lang} page="careers" title={page.seoTitle} description={page.seoDescription} image={page.intro.image}>
  <section class="intro">
    <div class="wrap grid">
      <div class="copy" data-reveal>
        <p class="mono kicker">{page.intro.kicker}</p>
        <h1 class="display">{page.intro.title}</h1>
        <p class="lead muted">{page.intro.text}</p>
      </div>
      <div data-reveal style="--delay:.12s">
        <Frame src={page.intro.image} alt={lang === 'de' ? 'Das iwend-Team bei einer Liveproduktion' : 'The iwend crew at a live production'} label="Crew · Live" placeholder={UI[lang].placeholder} ratio="16 / 9" />
      </div>
    </div>
  </section>

  <section class="light section">
    <div class="wrap cols">
      <h2 class="h2" data-reveal>{page.about.title}</h2>
      <div class="about" data-reveal>
        <p class="lead">{page.about.text}</p>
        <div class="needs">
          <p class="mono red">{page.requirements.title}</p>
          <p>{page.requirements.text}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <header class="head" data-reveal>
        <h2 class="h2">{page.activities.title}</h2>
        <p class="mono muted">{page.activities.note}</p>
      </header>
      <ol class="activities">
        {
          page.activities.items.map((a, i) => (
            <li data-reveal style={`--delay:${(i % 3) * 0.06}s`}>
              <span class="mono red">{pad(i + 1)}</span>
              <h3>{a.title}</h3>
              <p class="muted">{a.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="light section" aria-labelledby="jobs-title">
    <div class="wrap">
      <h2 id="jobs-title" class="h2" data-reveal>{t.open}</h2>
      {
        jobs.length ? (
          <ul class="jobs">
            {jobs.map((j) => (
              <li class="job" data-reveal>
                <details>
                  <summary>
                    <span class="job-title">{j.title}</span>
                    <span class="mono meta">
                      {j.location} · {j.employment}
                    </span>
                  </summary>
                  <div class="job-body">
                    <j.Content />
                    {j.expires && (
                      <p class="mono muted">
                        {t.until}: {date(j.expires)}
                      </p>
                    )}
                    <a class="btn btn--red" href={mail(j.contactEmail || page.cta.email, j.title)}>
                      {t.apply}
                    </a>
                  </div>
                </details>
              </li>
            ))}
          </ul>
        ) : (
          <div class="empty" data-reveal>
            <p class="lead">{page.openings.text}</p>
            <a class="btn btn--ghost" href="#apply">{page.cta.title}</a>
          </div>
        )
      }
    </div>
  </section>

  <section class="section" aria-labelledby="glossary-title">
    <div class="wrap cols">
      <header class="copy" data-reveal>
        <h2 id="glossary-title" class="h2">{page.glossary.title}</h2>
        <p class="muted">{page.glossary.text}</p>
      </header>
      <dl class="glossary">
        {
          page.glossary.items.map((g) => (
            <div data-reveal>
              <dt>{g.term}</dt>
              <dd class="muted">{g.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="light section" aria-labelledby="cables-title">
    <div class="wrap">
      <h2 id="cables-title" class="h2 head" data-reveal>{page.cables.title}</h2>
      <ul class="cables">
        {
          page.cables.items.map((c, i) => (
            <li class:list={['cable', { 'has-img': hasImage(c.image) }]} data-reveal style={`--delay:${(i % 3) * 0.06}s`} tabindex={hasImage(c.image) ? 0 : undefined}>
              {hasImage(c.image) && <img class="plug" src={withBase(c.image)} alt="" loading="lazy" decoding="async" />}
              <span class="mono red">C-{pad(i + 1)}</span>
              <h3>{c.name}</h3>
              <p class="muted">{c.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="safety-title">
    <div class="wrap cols">
      <h2 id="safety-title" class="h2" data-reveal>{page.safety.title}</h2>
      <ol class="safety">
        {
          page.safety.items.map((item, i) => (
            <li data-reveal>
              <span class="mono red">{pad(i + 1)}</span>
              <p>{item}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="light section">
    <div class="wrap">
      <h2 class="h2 head" data-reveal>{page.process.title}</h2>
      <ol class="steps">
        {
          page.process.steps.map((s, i) => (
            <li data-reveal style={`--delay:${i * 0.08}s`}>
              <span class="mono red">STEP {pad(i + 1)}</span>
              <h3>{s.title}</h3>
              <p class="muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="apply" class="apply">
    <div class="wrap" data-reveal>
      <h2 class="display">{page.cta.title}</h2>
      <p class="lead">{page.cta.text}</p>
      <a class="btn btn--dark" href={mail(page.cta.email, page.cta.title)}>{page.cta.button}</a>
      <p class="mono small">{page.cta.email} · {site.phone}</p>
    </div>
  </section>
</Base>

<style>
  .intro h1 {
    font-size: clamp(2.6rem, 5.6vw, 6rem);
  }
  .intro {
    padding-block: calc(var(--header-h) + clamp(48px, 8vw, 120px)) var(--section);
  }
  .grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: end;
  }
  .copy,
  .head {
    display: grid;
    gap: 1.25rem;
  }
  .head {
    margin-bottom: clamp(40px, 6vw, 80px);
  }
  .kicker {
    color: var(--on-dark-2);
  }
  .cols {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .red {
    color: var(--red);
  }
  h3 {
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
  }
  .activities,
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line-dark);
  }
  .activities li,
  .steps li {
    display: grid;
    align-content: start;
    gap: 0.9rem;
    padding: clamp(24px, 3vw, 40px) clamp(16px, 2vw, 28px) clamp(32px, 4vw, 56px) 0;
    border-bottom: 1px solid var(--line-dark);
  }
  .about {
    display: grid;
    gap: 2rem;
  }
  .needs {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.25rem;
    border-left: 2px solid var(--red);
    max-width: 38rem;
  }
  .glossary {
    margin: 0;
    border-top: 1px solid var(--line-dark);
  }
  .glossary div {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line-dark);
  }
  dt {
    font-size: clamp(1.5rem, 2.8vw, 2.4rem);
    font-weight: 800;
    font-stretch: 75%;
    line-height: 1;
    text-transform: uppercase;
  }
  dd {
    margin: 0;
  }
  .glossary div:hover dt {
    color: var(--red);
  }
  .cables {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .cables li {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: clamp(24px, 3vw, 40px);
    background: var(--paper);
    overflow: hidden;
    isolation: isolate;
  }
  /* Connector photo fades in on hover/focus; the text moves onto the dark image. */
  .plug {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
    opacity: 0;
    transform: scale(1.06);
    transition: opacity 0.45s var(--ease), transform 0.8s var(--ease);
  }
  .has-img {
    cursor: default;
    transition: color 0.45s var(--ease);
  }
  @media (hover: hover) {
    .has-img:is(:hover, :focus-visible) {
      color: var(--white);
    }
    .has-img:is(:hover, :focus-visible) .plug {
      opacity: 1;
      transform: none;
    }
    .has-img:is(:hover, :focus-visible)::after {
      opacity: 1;
    }
    .has-img:is(:hover, :focus-visible) .muted {
      color: rgb(255 255 255 / 0.88);
    }
  }
  .has-img::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(11 12 14 / 0.82), rgb(11 12 14 / 0.5) 55%, rgb(11 12 14 / 0.8));
    opacity: 0;
    transition: opacity 0.45s var(--ease);
  }
  .has-img .muted {
    transition: color 0.45s var(--ease);
  }
  @media (hover: none) {
    .has-img::after {
      display: none;
    }
    /* Touch devices: show the photo as a small thumbnail instead of on hover. */
    .plug {
      position: static;
      width: 96px;
      height: 96px;
      opacity: 1;
      transform: none;
      z-index: 0;
    }
  }
  .safety li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line-dark);
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
  }
  .safety {
    border-top: 1px solid var(--line-dark);
  }
  .light .steps,
  .light .steps li {
    border-color: var(--line);
  }
  .jobs {
    margin-top: clamp(32px, 5vw, 64px);
    border-top: 1px solid var(--line);
  }
  .job {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 2rem;
    padding-block: 1.5rem;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .job-title {
    font-size: clamp(1.5rem, 3vw, 2.6rem);
    font-weight: 800;
    font-stretch: 78%;
    text-transform: uppercase;
  }
  .meta {
    color: var(--muted);
  }
  .job-body {
    display: grid;
    gap: 1rem;
    justify-items: start;
    max-width: 44rem;
    padding-bottom: 2rem;
  }
  .empty {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    margin-top: clamp(32px, 5vw, 64px);
    padding: clamp(28px, 4vw, 48px);
    border: 1px dashed var(--line-strong, rgb(14 16 20 / 0.3));
  }
  .apply {
    background: var(--red);
    color: var(--white);
    padding-block: var(--section);
  }
  .apply .wrap {
    display: grid;
    gap: clamp(20px, 3vw, 32px);
    justify-items: start;
  }
  .btn--dark {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--white);
  }
  .btn--dark:hover {
    background: var(--white);
    color: var(--ink);
  }
  .small {
    opacity: 0.8;
  }
  @media (max-width: 900px) {
    .grid,
    .cols,
    .activities,
    .steps,
    .cables,
    .glossary div {
      grid-template-columns: 1fr;
    }
  }
</style>
