---
import { ANCHORS, type Lang } from '../../i18n/ui';
import { hasImage } from '../../lib/content';
import { withBase } from '../../lib/paths';

interface Member {
  id: string;
  name: string;
  role: string;
  text: string;
  group: 'management' | 'leads';
  portrait: string;
}

interface Props {
  lang: Lang;
  text: { kicker: string; title: string; text: string; leadsTitle: string; leadsText: string };
  members: Member[];
}

const { lang, text, members } = Astro.props;
const groups = [members.filter((m) => m.group === 'management'), members.filter((m) => m.group === 'leads')];
const initials = (name: string) =>
  name
    .replace(/^(Dipl\.-Ing\.|Dr\.|Prof\.)\s*/g, '')
    .split(/\s+/)
    .map((w) => w[0])
    .join('')
    .slice(0, 2);
---

<section id={ANCHORS[lang].team} class="team section" aria-labelledby="team-title">
  <div class="wrap">
    <header class="head" data-reveal>
      <p class="mono kicker">{text.kicker}</p>
      <h2 id="team-title" class="h2">{text.title}</h2>
      <p class="lead muted">{text.text}</p>
    </header>

    {
      groups.map((list, g) => (
        <div class="group">
          {g === 1 && (
            <div class="sub" data-reveal>
              <h3 class="h3">{text.leadsTitle}</h3>
              {list.length === 0 && <p class="muted">{text.leadsText}</p>}
            </div>
          )}
          <ol class="people">
            {list.map((m, i) => (
              <li class="person" data-reveal>
                <span class="mono idx">{String(i + 1).padStart(2, '0')}</span>
                <div class="who">
                  <p class="name">{m.name}</p>
                  <p class="mono role">{m.role}</p>
                  {m.text && <p class="muted note">{m.text}</p>}
                </div>
                <div class="portrait" aria-hidden={hasImage(m.portrait) ? undefined : 'true'}>
                  {hasImage(m.portrait) ? (
                    <img src={withBase(m.portrait)} alt={m.name} loading="lazy" decoding="async" />
                  ) : (
                    <span class="mono">{initials(m.name)}</span>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </div>
</section>

<style>
  .head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(48px, 8vw, 104px);
  }
  .kicker {
    color: var(--on-dark-2);
  }
  .people {
    border-top: 1px solid var(--line-dark);
  }
  .person {
    display: grid;
    grid-template-columns: 4rem 1fr clamp(120px, 14vw, 200px);
    gap: clamp(16px, 3vw, 40px);
    align-items: center;
    padding-block: clamp(20px, 3vw, 36px);
    border-bottom: 1px solid var(--line-dark);
  }
  .idx {
    color: var(--red);
    align-self: start;
    padding-top: 0.8em;
  }
  .name {
    font-size: clamp(2rem, 6vw, 5.6rem);
    font-weight: 800;
    font-stretch: 75%;
    line-height: 0.95;
    text-transform: uppercase;
    transition: color 0.3s var(--ease);
  }
  .person:hover .name {
    color: var(--red);
  }
  .role {
    margin-top: 0.9rem;
    color: var(--on-dark);
  }
  .note {
    margin-top: 0.4rem;
    max-width: 40ch;
  }
  .portrait {
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      repeating-linear-gradient(90deg, rgb(236 234 230 / 0.05) 0 1px, transparent 1px 24px),
      var(--ink-3);
    border: 1px solid var(--line-dark);
  }
  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.5s var(--ease);
  }
  .person:hover .portrait img {
    filter: none;
  }
  .portrait span {
    font-size: clamp(1.4rem, 2.4vw, 2.2rem);
    color: var(--on-dark-2);
  }
  .sub {
    display: grid;
    gap: 0.75rem;
    margin-top: clamp(56px, 8vw, 104px);
    margin-bottom: 1.5rem;
  }
  @media (max-width: 640px) {
    .person {
      grid-template-columns: 1fr 88px;
    }
    .idx {
      display: none;
    }
  }
</style>
