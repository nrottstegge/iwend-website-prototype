---
import { ANCHORS, type Lang } from '../../i18n/ui';
import { CITIES, MAP_H, MAP_W, OUTLINE_PATH, layoutTiles } from '../../lib/ruhr';
import { withBase } from '../../lib/paths';

interface Props {
  lang: Lang;
  text: { kicker: string; title: string; text: string };
  clients: { id: string; name: string; logo: string; background: 'light' | 'dark' }[];
}

const { lang, text, clients } = Astro.props;
const slots = layoutTiles(clients.length);
// Deterministic "cloud" start offsets for the arrival animation.
const scatter = (i: number) => {
  const a = Math.sin(i * 12.9898) * 43758.5453;
  const b = Math.sin(i * 78.233) * 12345.678;
  return [((a - Math.floor(a)) - 0.5) * 60, ((b - Math.floor(b)) - 0.5) * 50];
};
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
---

<section id={ANCHORS[lang].clients} class="clients light section" aria-labelledby="clients-title">
  <div class="wrap">
    <header class="head" data-reveal>
      <p class="mono kicker">{text.kicker}</p>
      <h2 id="clients-title" class="h2">{text.title}</h2>
    </header>

    <div class="map" data-reveal style={`--ratio:${MAP_W}/${MAP_H}`}>
      <svg viewBox={`0 0 ${MAP_W} ${MAP_H}`} aria-hidden="true">
        <defs>
          <pattern id="ruhr-dots" width="10" height="10" patternUnits="userSpaceOnUse">
            <circle cx="5" cy="5" r="1.3" />
          </pattern>
        </defs>
        <path d={OUTLINE_PATH} class="area" />
        <path d={OUTLINE_PATH} class="edge" />
        {slots.map((s) => <circle class="pin" cx={s.x} cy={s.y} r="6" />)}
        {
          CITIES.map((c) => (
            <g class:list={['city', { home: c.home }]}>
              <circle cx={c.x} cy={c.y} r={c.home ? 7 : 3.5} />
              <text x={c.x + 12} y={c.y - 10}>{c.name}</text>
            </g>
          ))
        }
      </svg>

      <ul class="tiles">
        {
          clients.map((c, i) => {
            const s = slots[i];
            const [sx, sy] = scatter(i + 1);
            const style = [
              `--x:${pct(s.x, MAP_W)}`,
              `--y:${pct(s.y, MAP_H)}`,
              `--w:${pct(s.w, MAP_W)}`,
              `--h:${pct(s.h, MAP_H)}`,
              `--sx:${sx.toFixed(1)}vw`,
              `--sy:${sy.toFixed(1)}vh`,
              `--delay:${(i * 0.045).toFixed(3)}s`,
            ].join(';');
            return (
              <li class:list={['tile', c.background]} style={style}>
                <img src={withBase(c.logo)} alt={c.name || (lang === 'de' ? 'Kundenlogo' : 'Client logo')} loading="lazy" decoding="async" />
                {c.name && <span class="name" aria-hidden="true">{c.name}</span>}
              </li>
            );
          })
        }
      </ul>
    </div>

    <p class="claim" data-reveal>{text.text}</p>
  </div>
</section>

<style>
  .clients {
    overflow-x: clip;
  }
  .head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(40px, 6vw, 80px);
  }
  .kicker {
    color: var(--muted);
  }
  .map {
    position: relative;
    aspect-ratio: var(--ratio);
  }
  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .area {
    fill: url(#ruhr-dots);
  }
  pattern circle {
    fill: rgb(14 16 20 / 0.2);
  }
  .edge {
    fill: none;
    stroke: rgb(14 16 20 / 0.35);
    stroke-width: 1.2;
    stroke-dasharray: 4 5;
  }
  .pin {
    display: none;
    fill: var(--fg);
  }
  .city circle {
    fill: var(--fg);
  }
  .city text {
    font: 500 13px var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--muted);
  }
  .home circle {
    fill: var(--red);
  }
  .home text {
    fill: var(--red);
  }

  .tile {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    height: var(--h);
    translate: -50% -50%;
    background: var(--white);
    box-shadow: 0 0 0 1px var(--line), 0 10px 30px -18px rgb(14 16 20 / 0.45);
    transition:
      transform 1.1s var(--ease) var(--delay),
      opacity 0.8s var(--ease) var(--delay),
      box-shadow 0.25s;
  }
  .tile.dark {
    background: var(--ink-2);
  }
  .tile img {
    position: absolute;
    inset: 10%;
    width: 80%;
    height: 80%;
    object-fit: contain;
  }
  .tile:hover {
    z-index: 2;
    box-shadow: 0 0 0 1px var(--fg), 0 14px 30px -14px rgb(14 16 20 / 0.5);
  }
  .name {
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    translate: -50% 0;
    padding: 0.3em 0.6em;
    background: var(--fg);
    color: var(--paper);
    font: 500 0.7rem/1.2 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
  }
  .tile:hover .name {
    opacity: 1;
  }
  /* Arrival: logos drift in from a loose cloud and settle into the silhouette. */
  :global(.js) .map:not(:global(.is-in)) .tile {
    transform: translate(var(--sx), var(--sy)) scale(0.7);
    opacity: 0;
  }
  :global(.js) .map[data-reveal] {
    transform: none;
  }

  .claim {
    margin-top: clamp(40px, 6vw, 72px);
    font-size: clamp(1.4rem, 2.6vw, 2.2rem);
    font-weight: 600;
    font-stretch: 85%;
    max-width: 28ch;
  }

  /* Small screens: the silhouette keeps pins, logos move into a tidy grid below. */
  @media (max-width: 760px) {
    .pin {
      display: block;
    }
    .city text {
      font-size: 22px;
    }
    .map {
      aspect-ratio: auto;
    }
    svg {
      position: relative;
      height: auto;
    }
    .tiles {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-top: 32px;
    }
    .tile {
      position: relative;
      left: auto;
      top: auto;
      width: auto;
      height: auto;
      aspect-ratio: 2 / 1;
      translate: none;
    }
    .name {
      display: none;
    }
  }
</style>
