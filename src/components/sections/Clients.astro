---
import { ANCHORS, type Lang } from '../../i18n/ui';
import { HOME, MAP_H, MAP_W, OUTLINE_PATH, cable, clusterByCity } from '../../lib/geo';
import { withBase } from '../../lib/paths';

interface Client {
  id: string;
  name: string;
  logo: string;
  city: string;
  lat?: number;
  lon?: number;
  background: 'light' | 'dark';
}

interface Props {
  lang: Lang;
  text: { kicker: string; title: string; text: string };
  clients: Client[];
}

const { lang, text, clients } = Astro.props;
const { clusters, unplaced } = clusterByCity(clients);
const fallbackAlt = lang === 'de' ? 'Kundenlogo' : 'Client logo';
const more = lang === 'de' ? 'Weitere' : 'More';
// Labels sit right of the dot, except in the eastern third of the map.
const labelLeft = (x: number) => x > MAP_W * 0.68;
---

<section id={ANCHORS[lang].clients} class="clients light section" aria-labelledby="clients-title">
  <div class="wrap">
    <header class="head" data-reveal>
      <p class="mono kicker">{text.kicker}</p>
      <h2 id="clients-title" class="h2">{text.title}</h2>
    </header>

    <div class="layout">
      <div class="map" data-reveal data-map>
        <svg viewBox={`0 0 ${MAP_W} ${MAP_H}`} role="img" aria-label={lang === 'de' ? 'Deutschlandkarte mit Firmensitzen unserer Kunden' : 'Map of Germany with our clients’ headquarters'}>
          <defs>
            <pattern id="de-dots" width="9" height="9" patternUnits="userSpaceOnUse">
              <circle cx="4.5" cy="4.5" r="1.1" />
            </pattern>
          </defs>
          <path d={OUTLINE_PATH} class="area" />
          <path d={OUTLINE_PATH} class="edge" />
          {clusters.map((c, i) => <path d={cable(c, i - Math.floor(clusters.length / 2))} class="cable" pathLength="1" style={`--i:${i}`} data-city={c.id} />)}
          {
            clusters.map((c, i) => (
              <g class="dot" style={`--i:${i}`} data-city={c.id}>
                <circle cx={c.x} cy={c.y} r={4 + Math.min(c.items.length, 5)} class="halo" />
                <circle cx={c.x} cy={c.y} r="3.5" />
                <text x={labelLeft(c.x) ? c.x - 14 : c.x + 14} y={c.y + 4} text-anchor={labelLeft(c.x) ? 'end' : 'start'}>
                  {c.label}
                </text>
              </g>
            ))
          }
          <g class="home">
            <circle cx={HOME.x} cy={HOME.y} r="12" class="halo" />
            <circle cx={HOME.x} cy={HOME.y} r="6" />
            <text x={HOME.x - 4} y={HOME.y - 18}>iwend · {HOME.name}</text>
          </g>
        </svg>
      </div>

      <ol class="groups">
        {
          clusters.map((c) => (
            <li class="group" data-reveal data-group={c.id}>
              <p class="mono city">
                {c.label} <span>{String(c.items.length).padStart(2, '0')}</span>
              </p>
              <ul class="tiles">
                {c.items.map((client) => (
                  <li class:list={['tile', client.background]} title={client.name || undefined}>
                    <img src={withBase(client.logo)} alt={client.name || fallbackAlt} loading="lazy" decoding="async" />
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
        {
          unplaced.length > 0 && (
            <li class="group" data-reveal>
              <p class="mono city">{more}</p>
              <ul class="tiles">
                {unplaced.map((client) => (
                  <li class:list={['tile', client.background]} title={client.name || undefined}>
                    <img src={withBase(client.logo)} alt={client.name || fallbackAlt} loading="lazy" decoding="async" />
                  </li>
                ))}
              </ul>
            </li>
          )
        }
      </ol>
    </div>

    <p class="claim" data-reveal>{text.text}</p>
  </div>
</section>

<script>
  // Hovering a city group highlights its cable and location on the map.
  const map = document.querySelector<HTMLElement>('[data-map]');
  document.querySelectorAll<HTMLElement>('[data-group]').forEach((g) => {
    const targets = map?.querySelectorAll(`[data-city="${g.dataset.group}"]`) ?? [];
    const set = (on: boolean) => {
      map?.classList.toggle('focus', on);
      targets.forEach((t) => t.classList.toggle('on', on));
    };
    g.addEventListener('mouseenter', () => set(true));
    g.addEventListener('mouseleave', () => set(false));
  });
</script>

<style>
  .head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(40px, 6vw, 80px);
  }
  .kicker {
    color: var(--muted);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .map {
    position: sticky;
    top: calc(var(--header-h) + 24px);
  }
  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .area {
    fill: url(#de-dots);
  }
  pattern circle {
    fill: rgb(14 16 20 / 0.2);
  }
  .edge {
    fill: none;
    stroke: rgb(14 16 20 / 0.4);
    stroke-width: 1;
    stroke-dasharray: 3 4;
  }
  text {
    font: 500 11px var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--fg);
  }
  .cable {
    fill: none;
    stroke: var(--red);
    stroke-width: 1.4;
    stroke-opacity: 0.75;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 0;
    transition:
      stroke-dashoffset 1.4s var(--ease) calc(0.2s + var(--i) * 0.08s),
      stroke-opacity 0.25s,
      stroke-width 0.25s;
  }
  .dot {
    transition: opacity 0.6s var(--ease) calc(0.9s + var(--i) * 0.08s);
  }
  .dot circle:not(.halo) {
    fill: var(--fg);
  }
  .halo {
    fill: rgb(229 37 33 / 0.14);
    stroke: rgb(229 37 33 / 0.5);
  }
  .home circle:not(.halo) {
    fill: var(--red);
  }
  .home text {
    fill: var(--red);
    font-weight: 600;
  }
  /* Drawn when the map scrolls into view. */
  :global(.js) .map:not(:global(.is-in)) .cable {
    stroke-dashoffset: 1;
  }
  :global(.js) .map:not(:global(.is-in)) .dot {
    opacity: 0;
  }
  :global(.js) .map[data-reveal] {
    transform: none;
  }
  .map:global(.focus) .cable:not(:global(.on)) {
    stroke-opacity: 0.15;
  }
  .cable:global(.on) {
    stroke-width: 2.4;
    stroke-opacity: 1;
  }
  .dot:global(.on) circle:not(.halo) {
    fill: var(--red);
  }

  .groups {
    border-top: 1px solid var(--line);
  }
  .group {
    display: grid;
    grid-template-columns: minmax(8rem, 1fr) 3fr;
    gap: 1.25rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
  }
  .city {
    padding-top: 0.6rem;
    transition: color 0.2s;
  }
  .city span {
    color: var(--muted);
    margin-left: 0.4em;
  }
  .group:hover .city {
    color: var(--red);
  }
  .tiles {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tile {
    position: relative;
    width: clamp(96px, 9vw, 128px);
    aspect-ratio: 2 / 1;
    background: var(--white);
    box-shadow: 0 0 0 1px var(--line);
  }
  .tile.dark {
    background: var(--ink-2);
  }
  .tile img {
    position: absolute;
    inset: 12%;
    width: 76%;
    height: 76%;
    object-fit: contain;
  }

  .claim {
    margin-top: clamp(40px, 6vw, 72px);
    font-size: clamp(1.4rem, 2.6vw, 2.2rem);
    font-weight: 600;
    font-stretch: 85%;
    max-width: 28ch;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .map {
      position: static;
      max-width: 460px;
    }
    .group {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .tile {
      width: calc((100% - 16px) / 3);
    }
  }
</style>
