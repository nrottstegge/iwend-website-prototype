---
import StadiumPlan from './StadiumPlan.astro';
import { LOGO_COLOR, LOGO_PATHS, LOGO_VIEWBOX } from '../../lib/logo';
import { ANCHORS, type Lang } from '../../i18n/ui';
import { hasImage } from '../../lib/content';
import { pageUrl, withBase } from '../../lib/paths';

interface Props {
  lang: Lang;
  hero: {
    kicker: string;
    headline: string;
    text: string;
    ctaPrimary: string;
    ctaSecondary: string;
    image: string;
  };
}

const { lang, hero } = Astro.props;
const photo = hasImage(hero.image) ? withBase(hero.image) : null;
const lines = hero.headline.split('\n');
const phases =
  lang === 'de'
    ? ['Kamerapositionen', 'Kabelwege & Stageboxen', 'Signal zum Ü-Wagen', 'iwend']
    : ['Camera positions', 'Cable runs & stageboxes', 'Signal to the OB van', 'iwend'];
// Each logo stroke is drawn from its first point; a cable from a stagebox ends exactly there (see hero.ts).
const strokes = LOGO_PATHS.map((d, i) => {
  const [, x, y] = /^M\s*(-?[\d.]+)[\s,]+(-?[\d.]+)/.exec(d)!;
  return { d, x: Number(x), y: Number(y), a: (0.62 + (i % 11) * 0.008).toFixed(3) };
});
const phaseWindows = [
  [0.04, 0.24],
  [0.24, 0.42],
  [0.42, 0.58],
  [0.58, 0.8],
];
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="stage" data-stage>
    {photo && <img class="photo" src={photo} alt="" fetchpriority="high" decoding="async" />}
    <div class="grid" aria-hidden="true"></div>
    <StadiumPlan lang={lang} />

    <div class="hud mono" aria-hidden="true">
      <span class="kicker">{hero.kicker}</span>
      <span class="tc">TC <span data-tc>00:00:00:00</span></span>
    </div>
    <ol class="phases mono" aria-hidden="true">
      {
        phases.map((label, i) => (
          <li style={`--a:${phaseWindows[i][0]};--b:${phaseWindows[i][1]}`}>
            <span>0{i + 1}</span> {label}
          </li>
        ))
      }
    </ol>
    <p class="hint mono" aria-hidden="true">Scroll <span>↓</span></p>

    <svg class="leads" data-leads aria-hidden="true"></svg>

    <div class="final">
      <div class="logo" data-logo>
        <svg viewBox={LOGO_VIEWBOX} role="img" aria-label="iwend">
          <g class="outline">{strokes.map((s) => <path d={s.d} pathLength="1" data-x={s.x} data-y={s.y} style={`--a:${s.a}`} />)}</g>
          <g class="fill" fill={LOGO_COLOR}>{LOGO_PATHS.map((d) => <path d={d} />)}</g>
        </svg>
      </div>
      <div class="copy" data-copy>
        <h1 id="hero-title" class="title">
          {lines.map((l, i) => <span class:list={['line', { accent: i === lines.length - 1 }]}>{l}</span>)}
        </h1>
        <p class="lead">{hero.text}</p>
        <div class="ctas">
          <a class="btn btn--red" href={pageUrl('home', lang, `#${ANCHORS[lang].contact}`)}>{hero.ctaPrimary}</a>
          <a class="btn btn--ghost" href={pageUrl('home', lang, `#${ANCHORS[lang].services}`)}>{hero.ctaSecondary}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initHero } from './hero';
  initHero(document.querySelector<HTMLElement>('[data-hero]')!);
</script>

<style>
  /* Default (no JS, reduced motion): --p = 1 renders the final frame in one viewport. */
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 620px;
    background: var(--ink);
  }
  /* Scroll-driven mode: enabled before first paint via html.js, so there is no flash. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero {
      height: 330vh;
    }
    :global(.js) .stage {
      --p: 0;
    }
  }
  .stage {
    --p: 1;
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    min-height: 620px;
    overflow: hidden;
    isolation: isolate;
  }
  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.55) contrast(1.05);
    opacity: calc(0.62 - 0.4 * clamp(0, (var(--p) - 0.5) / 0.2, 1));
    transform: scale(calc(1.08 - 0.08 * var(--p)));
    z-index: -2;
  }
  .grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(11 12 14 / 0.55), rgb(11 12 14 / 0.2) 40%, rgb(11 12 14 / 0.85)),
      repeating-linear-gradient(90deg, rgb(236 234 230 / 0.035) 0 1px, transparent 1px 80px),
      repeating-linear-gradient(0deg, rgb(236 234 230 / 0.035) 0 1px, transparent 1px 80px);
  }

  .hud {
    position: absolute;
    top: calc(var(--header-h) + 16px);
    left: var(--gutter);
    right: var(--gutter);
    display: flex;
    justify-content: space-between;
    color: var(--on-dark-2);
    opacity: calc(1 - clamp(0, (var(--p) - 0.78) / 0.06, 1));
  }
  .tc {
    font-variant-numeric: tabular-nums;
  }

  .phases {
    position: absolute;
    left: var(--gutter);
    bottom: clamp(24px, 5vh, 48px);
    color: var(--on-dark);
  }
  .phases li {
    position: absolute;
    bottom: 0;
    white-space: nowrap;
    opacity: calc(clamp(0, (var(--p) - var(--a)) / 0.025, 1) * (1 - clamp(0, (var(--p) - var(--b) + 0.025) / 0.025, 1)));
  }
  .phases span {
    color: var(--red);
    margin-right: 0.6em;
  }
  .hint {
    position: absolute;
    left: 50%;
    bottom: clamp(24px, 5vh, 48px);
    translate: -50% 0;
    color: var(--on-dark-2);
    opacity: calc(1 - clamp(0, var(--p) / 0.04, 1));
  }
  .hint span {
    display: inline-block;
    animation: nudge 2s var(--ease) infinite;
  }
  @keyframes nudge {
    50% {
      transform: translateY(4px);
    }
  }

  .final {
    position: absolute;
    inset: var(--header-h) var(--gutter) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(28px, 5vh, 56px);
    text-align: center;
    pointer-events: none;
    /* Brand-message phase: logo settles first (--td), then the copy follows (--tc). */
    --td: clamp(0, (var(--p) - 0.78) / 0.1, 1);
    --tc: clamp(0, (var(--p) - 0.86) / 0.09, 1);
  }
  .logo {
    width: clamp(220px, 34vw, 520px);
    /* JS sets --shift so the logo sits at the viewport centre until the copy appears. */
    transform: translateY(calc((1 - var(--td)) * var(--shift, 0px))) scale(calc(1 + 0.35 * (1 - var(--td))));
  }
  .logo svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  /* Cables from the stageboxes to the start of each logo stroke (built by hero.ts in stage pixels). */
  .leads {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .leads :global(path) {
    --t: clamp(0, (var(--p) - var(--a)) / var(--d), 1);
    fill: none;
    stroke: var(--red);
    stroke-width: var(--lead-w, 1.4);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1 1;
    stroke-dashoffset: calc(1 - var(--t));
    opacity: calc(1 - clamp(0, (var(--p) - 0.74) / 0.04, 1));
  }
  .outline path {
    fill: none;
    stroke: var(--red);
    /* hero.ts gives the cables the same on-screen width. */
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 1 1;
    stroke-dashoffset: calc(1 - clamp(0, (var(--p) - var(--a)) / 0.09, 1));
    opacity: calc(clamp(0, (var(--p) - var(--a)) / 0.005, 1) * (1 - clamp(0, (var(--p) - 0.79) / 0.04, 1)));
  }
  .fill {
    opacity: clamp(0, (var(--p) - 0.72) / 0.08, 1);
  }
  .copy {
    opacity: var(--tc);
    transform: translateY(calc((1 - var(--tc)) * 32px));
    pointer-events: auto;
    display: grid;
    justify-items: center;
    gap: clamp(18px, 3vh, 28px);
  }
  .title {
    font-size: clamp(2.1rem, 5vw, 5.4rem);
  }
  .line {
    display: block;
  }
  .accent {
    color: var(--on-dark-2);
  }
  .lead {
    color: var(--on-dark-2);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  @media (max-width: 700px) and (prefers-reduced-motion: no-preference) {
    :global(.js) .hero {
      height: 260vh;
    }
  }
  @media (max-width: 700px) {
    .hud .kicker {
      display: none;
    }
    .logo {
      width: min(62vw, 300px);
    }
  }
</style>
