---
import { CABLES, CAMERAS, OB_VANS, PITCH, PLAN_H, PLAN_W, SEAT_LINES, STAGEBOXES, TRUNKS } from './plan';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const P = PITCH;
const goal = (left: boolean, depth: number, h: number) => {
  const x = left ? P.x : P.x + P.w - depth;
  return { x, y: P.y + (P.h - h) / 2, width: depth, height: h };
};
// Animation windows (start, duration) in scroll progress 0..1 – see docs/design.md.
const cam = (i: number) => `--a:${0.05 + i * 0.035};--d:0.06`;
const cable = (i: number) => `--a:${0.24 + i * 0.03};--d:0.14`;
const trunk = (i: number) => `--a:${0.42 + i * 0.03};--d:0.12`;
---

<svg class="plan" viewBox={`0 0 ${PLAN_W} ${PLAN_H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <g class="base">
    <rect x="245" y="72" width="1110" height="756" rx="210" class="bowl" />
    <rect x="345" y="150" width="910" height="600" rx="96" class="bowl" />
    <path d={SEAT_LINES} class="seats" />
    <g class="pitch">
      <rect x={P.x} y={P.y} width={P.w} height={P.h} />
      <path d={`M${P.x + P.w / 2},${P.y}V${P.y + P.h}`} />
      <circle cx={P.x + P.w / 2} cy={P.y + P.h / 2} r="66" />
      <rect {...goal(true, 119, 290)} />
      <rect {...goal(false, 119, 290)} />
      <rect {...goal(true, 40, 132)} />
      <rect {...goal(false, 40, 132)} />
    </g>
    {
      OB_VANS.map((v) => (
        <g class="ob">
          <rect x={v.x} y={v.y} width={v.w} height={v.h} rx="4" />
          <text x={v.x + 12} y={v.y + v.h / 2 + 5}>{v[lang]}</text>
        </g>
      ))
    }
  </g>

  <g class="net">
    {TRUNKS.map((d, i) => <path d={d} class="cable trunk" pathLength="1" style={trunk(i)} />)}
    {CABLES.map((d, i) => <path d={d} class="cable" pathLength="1" style={cable(i)} />)}
    {
      STAGEBOXES.map((s, i) => (
        <g class="node" style={`--a:${0.3 + i * 0.04};--d:0.06`} data-stagebox>
          <rect x={s.x - 11} y={s.y - 11} width="22" height="22" />
          <text x={s.x + 18} y={s.y - 14}>{s.id}</text>
        </g>
      ))
    }
    {
      CAMERAS.map((c, i) => {
        const [tx, ty, anchor] =
          c.label === 'above' ? [c.x, c.y - 30, 'middle'] : c.label === 'below' ? [c.x, c.y + 44, 'middle'] : c.label === 'left' ? [c.x - 28, c.y + 5, 'end'] : [c.x + 28, c.y + 5, 'start'];
        return (
          <g class="cam" style={cam(i)}>
            <circle cx={c.x} cy={c.y} r="20" class="ring" />
            <circle cx={c.x} cy={c.y} r="7" class="dot" />
            <text x={c.x} y={c.y + 6} text-anchor="middle" class="num">{c.id}</text>
            <text x={tx} y={ty} text-anchor={anchor} class="label">
              <tspan class="id">CAM {c.id}</tspan>
              <tspan class="role" x={tx} dy="17">{c[lang]}</tspan>
            </text>
          </g>
        );
      })
    }
  </g>

</svg>

<style>
  .plan {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    font-family: var(--mono);
    /* Plan dims while the logo forms. */
    --dim: clamp(0, (var(--p) - 0.56) / 0.16, 1);
  }
  .base,
  .net {
    opacity: calc(1 - 0.82 * var(--dim));
  }
  .bowl,
  .pitch :is(rect, path, circle) {
    fill: none;
    stroke: rgb(236 234 230 / 0.34);
    stroke-width: 1.2;
  }
  .seats {
    stroke: rgb(236 234 230 / 0.12);
    stroke-width: 1;
  }
  .ob rect {
    fill: rgb(11 12 14 / 0.6);
    stroke: rgb(236 234 230 / 0.5);
  }
  text {
    fill: var(--on-dark);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .role {
    fill: var(--on-dark-2);
    font-size: 11px;
  }
  .num {
    display: none;
  }

  /* Shared progress window: --t goes 0 → 1 between --a and --a + --d. */
  .cam,
  .node,
  .cable {
    --t: clamp(0, (var(--p) - var(--a)) / var(--d), 1);
  }
  .cam,
  .node {
    opacity: var(--t);
  }
  .ring {
    fill: rgb(229 37 33 / 0.12);
    stroke: var(--red);
    stroke-width: 1.2;
  }
  .dot {
    fill: var(--red);
  }
  .node rect {
    fill: var(--ink);
    stroke: var(--on-dark);
    stroke-width: 1.4;
  }
  .cable {
    fill: none;
    stroke: var(--red);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-dasharray: 1 1;
    stroke-dashoffset: calc(1 - var(--t));
  }
  .trunk {
    stroke: var(--on-dark);
    stroke-width: 1.6;
    stroke-opacity: 0.75;
  }

  /* Portrait screens: turn the stadium 90° so the whole bowl fits; labels stay upright. */
  @media (max-aspect-ratio: 4 / 5) {
    .plan {
      inset: auto;
      top: 50%;
      left: 50%;
      width: 100vh;
      width: 100svh;
      max-width: none;
      height: 100vw;
      translate: -50% -50%;
      rotate: 90deg;
    }
    text {
      transform-box: fill-box;
      transform-origin: center;
      rotate: -90deg;
    }
    .cam .label,
    .cam .dot,
    .ob text {
      display: none;
    }
    .cam .num {
      display: block;
      font-size: 17px;
      fill: var(--white);
    }
    .ring {
      fill: rgb(229 37 33 / 0.85);
    }
  }
  @media (max-width: 700px) {
    .role {
      display: none;
    }
    text {
      font-size: 22px;
    }
  }
</style>
