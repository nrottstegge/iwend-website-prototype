---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { LANGS, UI, type Lang, type PageKey } from '../i18n/ui';
import { pageUrl, withBase } from '../lib/paths';
import { getSite } from '../lib/content';

interface Props {
  lang: Lang;
  page: PageKey;
  title: string;
  description?: string;
  image?: string;
}

const { lang, page, title, description, image } = Astro.props;
const site = await getSite(lang);
const desc = description || site.description;
const canonical = new URL(pageUrl(page, lang), Astro.site).href;
const ogImage = image ? new URL(withBase(image), Astro.site).href : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    {site.noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0b0c0e" />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(pageUrl(page, l), Astro.site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(pageUrl(page, 'de'), Astro.site).href} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.company} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">{UI[lang].skip}</a>
    <Header lang={lang} page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} page={page} />
    <script>
      // Reveal-on-scroll for elements marked [data-reveal]; one shared observer.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries)
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
        },
        { rootMargin: '0px 0px -12% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed;
    left: var(--gutter);
    top: 10px;
    z-index: 100;
    padding: 0.6rem 1rem;
    background: var(--red);
    color: var(--white);
    transform: translateY(-200%);
  }
  .skip:focus {
    transform: none;
  }
</style>
